# --- Supabase (shared platform: ghvjdybgllufjtdurbvh) ---
# URL and publishable key are public by design; the secret key must never
# be exposed to the browser or committed.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=https://ghvjdybgllufjtdurbvh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the browser, never commit.
SUPABASE_SECRET_KEY=

# --- NVIDIA AI (primary AI engine per master spec, server-only) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# --- Google Gemini (secondary AI engine, server-only) ---
# Used automatically when NVIDIA_API_KEY is not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Hostinger SMTP/IMAP (server-only; initial mode is DRAFT_ONLY) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASSWORD=

# --- Website enquiry CORS (comma-separated allowed origins) ---
ALLOWED_ENQUIRY_ORIGINS=

# Protects cron/automation endpoints (server-only)
CRON_SECRET=
